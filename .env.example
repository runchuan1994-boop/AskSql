# ============================================
# NL2SQL Agent 环境变量配置
# 复制此文件为 .env 后修改
# ============================================

# ===== LLM 配置 =====
# claude / openai / local_openai_compatible
LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 本地兼容
OPENAI_API_KEY=sk-
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ===== Agent 配置（可选） =====
# MAX_ITERATIONS=5
# MAX_PROBE_ITERATIONS=3
# SQL_TIMEOUT_SECONDS=30
# SQL_MAX_ROWS=1000

# ===== 沙盒配置（可选） =====
# 是否启用沙盒执行（true/false）
# 启用后 Agent 可以在沙盒中动态安装驱动、测试连接，SQL 查询也在隔离容器中执行
# 默认关闭（关闭时所有操作在主进程本地执行）
SANDBOX_ENABLED=false

# 容器运行时: runc（默认） / runsc（gVisor，需要 Linux + 安装 runsc）
SANDBOX_RUNTIME=runc

# 沙盒镜像名称
SANDBOX_IMAGE=nl2sql-sandbox:latest

# 沙盒资源限制
SANDBOX_MEMORY=256m
SANDBOX_CPU=0.5
SANDBOX_TIMEOUT=30
SANDBOX_POOL_MAX=4

# 是否允许沙盒访问外网
# - 启用后沙盒可以 pip install 驱动（驱动安装需要网络）
# - 如果数据库驱动都预装在镜像里，且不需要外网访问，可以设为 false 更安全
SANDBOX_NETWORK=false

# 沙盒加入的 Docker 网络名（用于访问 Compose 内的数据库等服务）
# - Docker Compose 部署时自动设置为 <项目名>_default（无需手动配置）
# - 非 Compose 部署或自定义网络时手动设置
# SANDBOX_NETWORK_MODE=nl2sql_default

# ===== Langfuse 可观测性（可选） =====
# 启用后，LLM 调用和 Agent 执行链路会发送到 Langfuse 进行追踪和分析
# 启动 Langfuse 服务: make langfuse-up
# 访问 UI: http://localhost:3030
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
