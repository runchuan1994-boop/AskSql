# ============================================
# NL2SQL Agent 环境变量配置
# 复制此文件为 .env 后修改
# ============================================

# ===== LLM 配置 =====
# claude / openai / local_openai_compatible
LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / 本地兼容
OPENAI_API_KEY=sk-
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ===== Agent 配置（可选） =====
# MAX_ITERATIONS=5
# MAX_PROBE_ITERATIONS=3
# SQL_TIMEOUT_SECONDS=30
# SQL_MAX_ROWS=1000
